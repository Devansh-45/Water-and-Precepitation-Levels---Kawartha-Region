wl_MariposaBrook_3.drop(columns=['ts_name', 'ts_id', 'Units', 'station_name', 'station_id'], inplace=True)
print(wl_MariposaBrook_3.info())

wl_MariposaBrook_4 = pd.read_csv('MariposaBrook-WL_2016-2024.csv')
wl_MariposaBrook_4['Timestamp'] = pd.to_datetime(wl_MariposaBrook_4['Timestamp'], errors='coerce', infer_datetime_format=True)
