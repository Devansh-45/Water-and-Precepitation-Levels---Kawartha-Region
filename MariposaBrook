wl_MariposaBrook_2.drop(columns=['ts_name', 'ts_id', 'Units', 'station_name', 'station_id'], inplace=True)
print(wl_MariposaBrook_2.info())

wl_MariposaBrook_3 = pd.read_csv('MariposaBrook-WL_2006-2015.csv')
wl_MariposaBrook_3['Timestamp'] = pd.to_datetime(wl_MariposaBrook_3['Timestamp'], errors='coerce', infer_datetime_format=True)
